{
    "name": "filagora/filagora-newsletters",
    "description": "Newsletters for Filagora: subscribers with consent, campaigns built from content blocks, scheduled sends, link tracking, and delivery events, independent of any one mail provider.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filagora",
        "newsletters",
        "email"
    ],
    "require": {
        "filagora/filagora-core": "^0.2.2",
        "filament/filament": "^5.0",
        "php": "^8.4"
    },
    "require-dev": {
        "filagora/filagora-entitlements": "^0.2.2",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Filagora\\Newsletters\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Filagora\\Newsletters\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Filagora\\Newsletters\\NewslettersServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
